{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./build",
    "rootDir": ".",
    "types": ["zotero-types"]
  },
  "include": ["src/**/*.ts", "typings/global.d.ts"],
  "exclude": ["node_modules", "build", "test"]
}
