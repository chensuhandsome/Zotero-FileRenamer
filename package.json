{
  "name": "zotero-filerenamer",
  "version": "1.0.0",
  "description": "Auto-number Zotero references by citation hierarchy via INSPIRE-HEP",
  "config": {
    "addonName": "zotero-filerenamer",
    "addonID": "zotero-filerenamer@user",
    "addonRef": "zoterofilerenamer",
    "addonInstance": "ZoteroFileRenamer",
    "prefsPrefix": "extensions.zotero.filerenamer"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/user/zotero-filerenamer.git"
  },
  "author": "Chen Su",
  "license": "MIT",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "tsc --noEmit && zotero-plugin build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.7.2",
    "vitest": "^4.0.15",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.0.5"
  }
}
